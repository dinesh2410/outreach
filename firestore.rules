// Firestore security rules — paste these into Firebase Console → Firestore Database → Rules tab.
// They enforce: a signed-in user can only read/write their OWN documents under /users/{uid}/...

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email allow-list. MUST stay in sync with lib/admins.ts —
    // both files define the same set; the TS file gates the UI, this
    // file gates the underlying Firestore reads.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'support@testerscommunity.com',
          'dinesh.ch@testerscommunity.com'
        ];
    }

    // The user's profile document. Owner-only access.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Apps live as subcollection of the user. Same owner-only rule.
      match /apps/{appId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Saved generations subcollection. Same owner-only rule.
      match /savedGenerations/{genId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Auto-recorded history of every generation. Same owner-only rule.
      match /history/{genId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Auto-recorded Score Checker audits. Same owner-only rule.
      match /audits/{auditId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Auto-recorded Competitor Watch analyses. Same owner-only rule.
      match /competitors/{competitorId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Auto-recorded keyword rank checks. Same owner-only rule.
      match /keywordRanks/{rankId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Auto-recorded Reddit demand analyses. Same owner-only rule.
      match /redditAnalyses/{analysisId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // "Your applications" — apps the user saved as reusable inputs across tools.
      // Owner-only.
      match /myApps/{appId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Review Intelligence analyses. Owner-only.
      match /reviewIntelligence/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Per-generation usage records. Owner can read/write their own;
      // admins (see isAdmin() above) can also read for the /admin/usage
      // dashboard. Writes are owner-only — admins should never inject data.
      match /usage/{genId} {
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null
          && (request.auth.uid == uid || isAdmin());
      }
    }

    // Admin-only collectionGroup read on `usage` so /admin/usage can
    // aggregate across every user's subcollection in one query. The match
    // path uses `{path=**}` because collectionGroup queries don't follow
    // the per-user document path. Writes still go through the per-user
    // rule above, which enforces owner-only writes.
    match /{path=**}/usage/{genId} {
      allow read: if isAdmin();
    }

    // Default deny — anything not explicitly allowed above is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
